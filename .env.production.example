# betathesis.com production env TEMPLATE (safe to commit — placeholders only).
# Copy to `.env.production` (gitignored) and fill real values, then place on anton at
# /home/veer/betathesis/.env.production. Loaded via the systemd EnvironmentFile.
# Every key below is read at runtime by the standalone server; a missing one silently
# breaks that feature (markets / news / prices / chart / chat / signals / auth).

NODE_ENV=production

# --- Auth.js (Google sign-in) ---
NEXTAUTH_URL=https://betathesis.com
AUTH_URL=https://betathesis.com
AUTH_TRUST_HOST=true
AUTH_SECRET=            # openssl rand -base64 32  (use a NEW one, not the dev secret)
AUTH_GOOGLE_ID=         # Google Cloud OAuth 2.0 client id (add prod redirect URIs — Phase 7)
AUTH_GOOGLE_SECRET=     # Google Cloud OAuth 2.0 client secret
# Native iOS Google Sign-In (smooth one-tap). OPTIONAL: only needed if the iOS app mints ID tokens for
# its own iOS OAuth client id. Preferred: configure GIDSignIn with serverClientID = AUTH_GOOGLE_ID and
# leave this unset, so native and web share one identity. Set to the iOS client id to also accept those.
GOOGLE_IOS_CLIENT_ID=   # (optional) iOS OAuth client id, e.g. 1234-abc.apps.googleusercontent.com
# Sign in with Apple (App Store Guideline 4.8 — required because we offer Google login). PAID Apple
# Developer account. Without these two the Apple button shows but errors on tap; Google is unaffected.
AUTH_APPLE_ID=          # Sign in with Apple **Services ID** (e.g. com.veeradittya.thesis.signin) — NOT the app bundle id
AUTH_APPLE_SECRET=      # ES256 client-secret JWT signed with the Sign in with Apple .p8 key (iss=TeamID, sub=ServicesID, aud=https://appleid.apple.com, exp<=6mo) — EXPIRES, renew

# --- Prediction markets (Oddpool: Kalshi + Polymarket) — CORE ---
ODDPOOL_API_KEY=

# --- News ---
GUARDIAN_API_KEY=
NYT_API_KEY=

# --- Live prices (Finnhub) + chart history (Alpaca IEX) ---
FINNHUB_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- LLM (Dartmouth Claude gateway primary; Anthropic fallback) ---
DARTMOUTH_API_KEY=
DARTMOUTH_GATEWAY_BASE=https://chat.dartmouth.edu/api
DARTMOUTH_MODEL=anthropic.claude-sonnet-4-5-20250929
ANTHROPIC_API_KEY=

# --- Plaid (sandbox; dormant) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- FRED (present for parity; not currently read) ---
FRED_API_KEY=

# --- Push notifications (APNs) — the daily "your brief is ready" alert ---
# Values come from the paid Apple Developer account submitting the app. APNS_KEY is the full text of
# the AuthKey_XXXXXX.p8 (paste the -----BEGIN/END PRIVATE KEY----- block; literal \n are handled).
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=            # must EXACTLY match the iOS app's bundle id (never hardcoded)
APNS_ENV=sandbox          # sandbox (dev / TestFlight) or production (App Store)
# Secret for POST /api/push/send-brief. Manual/agent calls send it as header x-push-secret.
PUSH_SEND_SECRET=
# Vercel Cron can't set custom headers, so it authenticates with Authorization: Bearer <CRON_SECRET>
# which Vercel injects automatically when CRON_SECRET is set. Set both (same value is fine).
CRON_SECRET=
